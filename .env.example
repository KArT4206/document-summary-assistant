# Google Gemini API key — server-side only, never exposed to the browser.
# Get one at https://aistudio.google.com/apikey
# Uses the Gemini API free tier (gemini-3.6-flash by default) — this project
# is intentionally kept at zero API cost. See docs/PRIVACY_AND_DATA_HANDLING.md
# and docs/SECURITY_ARCHITECTURE.md for the free-tier limits this implies.
GEMINI_API_KEY=

# Optional: override the model used for summarization (defaults to gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash

# Optional local-model fallback (Ollama), used only when Gemini genuinely
# indicates quota/rate exhaustion or a transient outage — never for
# validation/config errors. The browser never talks to Ollama directly.
#
# OLLAMA_FALLBACK_ENABLED defaults to disabled (unset/anything other than the
# literal string "true"). When disabled, no network call to OLLAMA_BASE_URL
# is ever attempted, regardless of what it's set to. This is deliberate:
# 127.0.0.1 has no meaning inside a deployed environment, so "production"
# must not silently assume a local Ollama server exists.
#
# Set to "true" only when OLLAMA_BASE_URL genuinely points to an Ollama
# server this application's backend can privately reach — a developer's own
# machine during local development, or (in production) a real, private
# Ollama deployment operated as part of that deployment. Never a developer's
# personal computer reachable from a deployed environment. See
# docs/SECURITY_ARCHITECTURE.md.
OLLAMA_FALLBACK_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
